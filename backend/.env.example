# CINEVERSE DISCOVERY - Environment Configuration
# Optional: The Movie Database (TMDB) API Key (free tier available at https://www.themoviedb.org/)
# If not provided, Cineverse Discovery automatically operates with the curated sample dataset.
TMDB_API_KEY=

# Local Server Settings
HOST=127.0.0.1
PORT=8000

# Storage Paths (defaults to local workspace)
DATASET_PATH=./data/sample_movies.csv
SQLITE_PATH=./watchlist.db
